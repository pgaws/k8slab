pipeline {
  agent {label 'ns17-kube'}
 
  stages {
 
    stage('Check on Kubernetes') {
      steps {
        sh '''
 
          kubectl get pods
          kubectl get svc
          kubectl get deployments
        '''
      }
    }
    stage('Deployment on Kubernetes') {
      steps {
        sh '''
          kubectl apply -f .
        '''
      }
    }
 

  }
}